# Nyaya – Environment Configuration
# Copy to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
DEBUG=false

# Optional: pre-set API keys (UI-entered keys take priority)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Paths (defaults are fine for local dev)
DATA_DIR=./data
CHROMA_DIR=./data/chroma
SQLITE_DB=./data/nyaya.db
KNOWLEDGE_BASE_DIR=./knowledge_base
UPLOAD_DIR=./data/uploads
ENCRYPTION_KEY_FILE=./data/.encryption_key

# Embedding model (local, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunk settings
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=50
