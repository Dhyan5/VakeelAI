# VakeelAI Environment Variables

# Groq API Key (Free tier at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# JWT Secret Key for Session Authentication
JWT_SECRET=vakeel_ai_super_secret_jwt_key_2026_change_me_in_prod

# Database URL (Turso libSQL or local SQLite)
# For local SQLite: sqlite:///legal_rag.db
# For Turso: libsql://[your-db]-[your-org].turso.io
DATABASE_URL=sqlite:///legal_rag.db

# Turso Auth Token (Required if using Turso cloud db)
TURSO_AUTH_TOKEN=

# Backend Host & Port Configuration (Default for local Uvicorn)
HOST=0.0.0.0
PORT=8000
